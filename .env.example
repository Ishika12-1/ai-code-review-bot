# ==========================================
# AI Code Review Bot - Environment Config
# ==========================================

# Application
ENVIRONMENT=development
PROJECT_NAME="AI Code Review Bot"
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
API_V1_STR=/api
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_code_review.db

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub App (for automated Webhook PR reviews)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# GitHub OAuth (for user login & repository explorer)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback?provider=github

# Google OAuth (for user login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback?provider=google
